# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore y NUNCA debe subirse: el repositorio es público.
#
# En producción (Dokploy) estas variables NO salen de aquí: se pegan en
# App -> Environment de la interfaz. Ver DEPLOY.md.

# --- Base de datos (desarrollo local con docker compose) ---
POSTGRES_USER=zonaxtrema
POSTGRES_PASSWORD=zonaxtrema
POSTGRES_DB=zonaxtrema
# Puerto expuesto en el host (5433 para no chocar con un Postgres local en 5432)
POSTGRES_PORT=5433

# Conexión completa. Si tiene valor, gana sobre los POSTGRES_* de arriba.
# Es la forma en que Dokploy entrega la base; en local se deja vacía.
DATABASE_URL=

# --- API ---
API_PORT=8000
SECRET_KEY=cambiar-en-produccion-usar-openssl-rand-hex-32
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# URL que ve el cliente desde fuera: es la de los enlaces de WhatsApp y los QR.
# En producción, el dominio real, o no abrirán desde el celular del cliente.
PUBLIC_BASE_URL=http://localhost:8000

# Zona horaria del negocio. Define dónde empieza y termina "el día" en el
# dashboard, los reportes, los arqueos y la fecha de emisión ante SUNAT.
TIMEZONE=America/Lima

# --- Seed inicial (permisos, roles y administrador) ---
# Si no se define ADMIN_PASSWORD, el seed genera una y la imprime en el log.
RUN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Facturación electrónica: emisión propia ante SUNAT ---
# Se emite directo, sin PSE. El XML se firma aquí con el certificado de la
# empresa: la clave privada no sale de este servidor.
#
# Sin CERTIFICADO_CLAVE, SOL_USUARIO y SOL_CLAVE el sistema opera en MODO
# SIMULACIÓN: construye y guarda los comprobantes pero no los manda a SUNAT.
#
# El certificado se MONTA como volumen (./certs:/certs:ro). Nunca se copia a la
# imagen ni se versiona.
CERTIFICADO_RUTA=/certs/certificado.pfx
CERTIFICADO_CLAVE=
# Usuario SOL SECUNDARIO, no el principal: se revoca sin tocar el otro.
SOL_USUARIO=
SOL_CLAVE=
# false = ambiente de pruebas de SUNAT (sin validez legal).
SUNAT_PRODUCCION=false

# Series autorizadas por SUNAT. Cuatro caracteres; F para facturas y sus notas,
# B para boletas y las suyas.
SERIE_BOLETA=B001
SERIE_FACTURA=F001
SERIE_NC_BOLETA=BC01
SERIE_NC_FACTURA=FC01

# Consulta RENIEC/SUNAT por DNI/RUC. Va por APIsPERU, independiente de la
# facturación: si un servicio cae, el otro sigue.
APISPERU_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TOKEN=

# --- Emisor (debe coincidir con la cuenta del facturador, que firma) ---
# Si no se define, se usan los valores por defecto de config.py.
EMISOR_RUC=
EMISOR_RAZON_SOCIAL=
EMISOR_NOMBRE_COMERCIAL=
# La dirección viaja en el XML y debe coincidir con el padrón de SUNAT.
EMISOR_UBIGEO=120101
EMISOR_DIRECCION=
EMISOR_DEPARTAMENTO=JUNIN
EMISOR_PROVINCIA=HUANCAYO
EMISOR_DISTRITO=HUANCAYO
