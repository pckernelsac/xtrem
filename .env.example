# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore y NUNCA debe subirse: el repositorio es público.
#
# En producción (Dokploy) estas variables NO salen de aquí: se pegan en
# App -> Environment de la interfaz. Ver DEPLOY.md.

# --- Base de datos (desarrollo local con docker compose) ---
POSTGRES_USER=zonaxtrema
POSTGRES_PASSWORD=zonaxtrema
POSTGRES_DB=zonaxtrema
# Puerto expuesto en el host (5433 para no chocar con un Postgres local en 5432)
POSTGRES_PORT=5433

# Conexión completa. Si tiene valor, gana sobre los POSTGRES_* de arriba.
# Es la forma en que Dokploy entrega la base; en local se deja vacía.
DATABASE_URL=

# --- API ---
API_PORT=8000
SECRET_KEY=cambiar-en-produccion-usar-openssl-rand-hex-32
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# URL que ve el cliente desde fuera: es la de los enlaces de WhatsApp y los QR.
# En producción, el dominio real, o no abrirán desde el celular del cliente.
PUBLIC_BASE_URL=http://localhost:8000

# Zona horaria del negocio. Define dónde empieza y termina "el día" en el
# dashboard, los reportes, los arqueos y la fecha de emisión ante SUNAT.
TIMEZONE=America/Lima

# --- Seed inicial (permisos, roles y administrador) ---
# Si no se define ADMIN_PASSWORD, el seed genera una y la imprime en el log.
RUN_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Facturación electrónica ---
# Proveedor activo: "nubefact" o "factpro". Conmutable para volver atrás sin
# desplegar código.
FACTURADOR=nubefact

# Nubefact. Sin RUTA y TOKEN el sistema emite en MODO SIMULACIÓN: los
# comprobantes no tienen validez ante SUNAT. Con credenciales las emisiones
# son reales. Ambos datos salen del panel de Nubefact, opción API-Integración.
# OJO: con Nubefact el correlativo lo lleva ESTE sistema, no el proveedor.
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

# FactPro (proveedor anterior; sólo se usa con FACTURADOR=factpro).
FACTPRO_BASE_URL=https://api.factpro.la/api/v3
FACTPRO_TOKEN=

# Consulta RENIEC/SUNAT por DNI/RUC. Va por APIsPERU, independiente del
# facturador: si el facturador cae, el autocompletado sigue funcionando.
APISPERU_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TOKEN=

# Series habilitadas EN LA CUENTA del facturador; no son libres. Las cuentas
# demo de Nubefact traen BBB1 y FFF1; en produccion, las que autorice SUNAT.
# Nubefact exige 4 caracteres y que empiecen por B (boletas) o F (facturas).
SERIE_BOLETA=B001
SERIE_FACTURA=F001
SERIE_NC_BOLETA=BC01
SERIE_NC_FACTURA=FC01

# --- Emisor (debe coincidir con la cuenta del facturador, que firma) ---
# Si no se define, se usan los valores por defecto de config.py.
EMISOR_RUC=
EMISOR_RAZON_SOCIAL=
